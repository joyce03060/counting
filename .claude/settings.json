{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(cargo *)",
      "Bash(pip *)",
      "Bash(python *)",
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(git *)",
      "Bash(dir *)",
      "Bash(ls *)",
      "Bash(Get-ChildItem *)",
      "Bash(New-Item *)",
      "Bash(Remove-Item *)",
      "Bash(mkdir *)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git *)",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .claude/hooks/check-gate.ps1"
          }
        ]
      }
    ],
    "PostToolUse": []
  }
}
